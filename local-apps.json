{
  "_about": "Programs ShowStack can name when it finds them listening on this computer outside your projects: AI chat and model servers, databases, dashboards, automation tools. Every localhost port that none of your project servers owns is attributed the same way, whatever holds it: a Docker container (its published ports, or with --network=host the ports its environment and image name), a process you can see, an HTTP reply that looks like a known app, or a port the app wrote into its own instance file. Fields: name. ports: its usual ports, tried first (for a tcp app held by a program you cannot see, the usual port alone names it as 'probably'). process: regex on the program name of a process you can see. cmdline: regex on its command line. image: regex on a Docker image name. http: GET requests to try, each {path, match}, match being a regex over the reply body and headers; the first app whose request matches wins, so JSON API checks come before page-title checks. instanceFile: a JSON file the app writes its port (and pid) into. protocol: http (default, the row gets a localhost link) or tcp. instanceFile may be one path or a list (Windows and Linux locations side by side; the ones that do not exist are skipped). Shared by the Windows and Linux versions. Add your own in showstack.json (next to ShowStack.ps1 on Windows, ~/.config/showstack/ on Linux) under localApps; an entry with the same name overrides the one here.",
  "apps": [
    {"name": "Open WebUI", "ports": [3000, 8080], "image": "open-webui", "http": [{"path": "/api/config", "match": "\"name\":\\s*\"Open WebUI\""}]},
    {"name": "Ollama", "ports": [11434], "process": "^ollama$", "image": "ollama/ollama", "http": [{"path": "/", "match": "Ollama is running"}]},
    {"name": "LM Studio", "ports": [1234], "process": "^(lms|lm-studio|lm_studio)", "http": [{"path": "/api/v0/models", "match": "\"data\""}]},
    {"name": "llama.cpp server", "ports": [8080], "process": "^llama-server$", "image": "llama\\.cpp", "http": [{"path": "/props", "match": "\"total_slots\"|\"default_generation_settings\""}]},
    {"name": "KoboldCpp", "ports": [5001], "process": "^koboldcpp", "http": [{"path": "/api/extra/version", "match": "KoboldCpp"}]},
    {"name": "LocalAI", "ports": [8080], "image": "localai", "cmdline": "local-ai"},
    {"name": "vLLM", "ports": [8000], "image": "vllm", "cmdline": "vllm\\.entrypoints|vllm serve"},
    {"name": "OpenWork engine", "cmdline": "OpenWork[/\\\\].*opencode", "instanceFile": ["~/.config/openwork/engine-instances.json", "%APPDATA%/openwork/engine-instances.json", "%LOCALAPPDATA%/openwork/engine-instances.json"]},
    {"name": "OpenCode server", "process": "^opencode$", "http": [{"path": "/doc", "match": "opencode"}]},
    {"name": "LibreChat", "ports": [3080], "image": "librechat", "http": [{"path": "/api/config", "match": "\"appTitle\""}]},
    {"name": "AnythingLLM", "ports": [3001], "image": "anythingllm", "http": [{"path": "/api/ping", "match": "\"online\":\\s*true"}]},
    {"name": "Jan", "ports": [1337], "image": "janhq", "process": "^(jan|cortex)"},
    {"name": "n8n", "ports": [5678], "image": "n8nio/n8n", "cmdline": "\\bn8n\\b", "http": [{"path": "/rest/settings", "match": "versionCli"}]},
    {"name": "Flowise", "ports": [3000], "image": "flowise", "cmdline": "flowise", "http": [{"path": "/api/v1/ping", "match": "pong"}]},
    {"name": "Dify", "ports": [80, 3000, 5001], "image": "langgenius/dify"},
    {"name": "ComfyUI", "ports": [8188], "cmdline": "ComfyUI", "http": [{"path": "/system_stats", "match": "\"comfyui_version\"|\"python_version\""}]},
    {"name": "Stable Diffusion WebUI", "ports": [7860], "cmdline": "stable-diffusion-webui", "http": [{"path": "/sdapi/v1/sd-models", "match": "\"model_name\""}]},
    {"name": "Gradio app", "ports": [7860], "http": [{"path": "/config", "match": "\"components\".*\"version\"|\"version\".*\"components\""}]},
    {"name": "Jupyter", "ports": [8888], "process": "^jupyter", "cmdline": "jupyter[-_ ](lab|notebook|server)", "http": [{"path": "/api", "match": "\"version\":\\s*\"\\d"}, {"path": "/", "match": "<title>Jupyter"}]},
    {"name": "code-server", "ports": [8080], "process": "^code-server", "cmdline": "code-server", "http": [{"path": "/healthz", "match": "\"status\":\\s*\"alive\""}]},
    {"name": "Grafana", "ports": [3000], "image": "grafana/grafana", "process": "^grafana", "http": [{"path": "/api/health", "match": "\"database\":\\s*\"ok\""}]},
    {"name": "Prometheus", "ports": [9090], "image": "prom/prometheus", "process": "^prometheus$", "http": [{"path": "/-/ready", "match": "Prometheus"}]},
    {"name": "Portainer", "ports": [9000, 9443], "image": "portainer", "http": [{"path": "/api/status", "match": "\"InstanceID\""}]},
    {"name": "pgAdmin", "ports": [5050], "image": "pgadmin4", "http": [{"path": "/misc/ping", "match": "PING"}]},
    {"name": "Mailpit", "ports": [8025], "image": "mailpit|mailhog", "process": "^(mailpit|mailhog)$", "http": [{"path": "/api/v1/info", "match": "\"LatestVersion\"|\"RuntimeStats\""}]},
    {"name": "MinIO", "ports": [9000, 9001], "image": "minio/minio", "process": "^minio$", "http": [{"path": "/minio/health/live", "match": "server:\\s*MinIO"}]},
    {"name": "Elasticsearch", "ports": [9200], "image": "elasticsearch", "http": [{"path": "/", "match": "\"tagline\":\\s*\"You Know, for Search\""}]},
    {"name": "Qdrant", "ports": [6333], "image": "qdrant", "http": [{"path": "/", "match": "\"title\":\\s*\"qdrant"}]},
    {"name": "ChromaDB", "ports": [8000], "image": "chromadb|chroma-core", "http": [{"path": "/api/v2/heartbeat", "match": "heartbeat"}]},
    {"name": "Meilisearch", "ports": [7700], "image": "getmeili/meilisearch", "process": "^meilisearch$", "http": [{"path": "/health", "match": "\"available\""}]},
    {"name": "SearXNG", "ports": [8080, 8888], "image": "searxng", "http": [{"path": "/config", "match": "\"instance_name\""}]},
    {"name": "RabbitMQ", "ports": [5672, 15672], "image": "rabbitmq", "http": [{"path": "/", "match": "<title>RabbitMQ Management"}]},
    {"name": "Keycloak", "ports": [8080, 8443], "image": "keycloak", "http": [{"path": "/realms/master", "match": "\"public_key\""}]},
    {"name": "Nextcloud", "ports": [8080], "image": "nextcloud", "http": [{"path": "/status.php", "match": "\"productname\":\\s*\"Nextcloud\""}]},
    {"name": "Gitea / Forgejo", "ports": [3000], "image": "gitea|forgejo", "http": [{"path": "/", "match": "<title>[^<]*(Gitea|Forgejo)"}]},
    {"name": "Home Assistant", "ports": [8123], "image": "home-assistant", "cmdline": "homeassistant", "http": [{"path": "/", "match": "<title>Home Assistant"}]},
    {"name": "Syncthing", "ports": [8384], "process": "^syncthing$", "http": [{"path": "/", "match": "Syncthing"}]},
    {"name": "Plex Media Server", "ports": [32400], "process": "^plex", "cmdline": "Plex Media Server", "http": [{"path": "/identity", "match": "MediaContainer"}]},
    {"name": "Jellyfin", "ports": [8096], "image": "jellyfin", "process": "^jellyfin$", "http": [{"path": "/System/Info/Public", "match": "\"ServerName\""}]},
    {"name": "Traefik", "ports": [8080], "image": "^traefik", "process": "^traefik$"},
    {"name": "Nginx", "image": "^nginx", "process": "^nginx$"},
    {"name": "Apache HTTP Server", "image": "^httpd", "process": "^(apache2|httpd)$"},
    {"name": "PostgreSQL", "ports": [5432], "protocol": "tcp", "process": "^(postgres|postmaster)$", "image": "postgres|pgvector|timescale|supabase/postgres"},
    {"name": "MySQL / MariaDB", "ports": [3306], "protocol": "tcp", "process": "^(mysqld|mariadbd)$", "image": "mysql|mariadb"},
    {"name": "MongoDB", "ports": [27017], "protocol": "tcp", "process": "^mongod$", "image": "^mongo"},
    {"name": "Redis", "ports": [6379], "protocol": "tcp", "process": "^(redis-server|valkey-server)", "image": "redis|valkey"},
    {"name": "Memcached", "ports": [11211], "protocol": "tcp", "process": "^memcached$", "image": "memcached"},
    {"name": "Kafka", "ports": [9092], "protocol": "tcp", "image": "kafka"}
  ]
}
